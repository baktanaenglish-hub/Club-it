<?xml version="1.0" encoding="utf-8" ?>
<!-- A benefit row, shared by the search and entertainment lists. -->
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:vm="clr-namespace:ClubIt.Mobile.Core.ViewModels;assembly=ClubIt.Mobile.Core"
        x:Class="ClubIt.Mobile.Pages.BenefitItemTemplate"
        x:DataType="vm:BenefitItemViewModel"
        Style="{StaticResource Card}"
        Margin="0,0,0,10">

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
        <HorizontalStackLayout Spacing="8">
            <Image Source="{Binding ClubLogoUrl}" HeightRequest="22" WidthRequest="22" IsVisible="{Binding HasClubLogo}" />
            <Label Text="{Binding ClubName}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
            <Label Text="·" Style="{StaticResource Caption}" />
            <Label Text="{Binding MerchantName}" Style="{StaticResource Caption}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource ValueBadge}">
            <Label Text="{Binding ValueText}" FontAttributes="Bold" TextColor="{StaticResource Tertiary}" />
        </Border>

        <Label Grid.Row="1" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />

        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BranchesText}" Style="{StaticResource Caption}" />

        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ValidityText}" Style="{StaticResource Caption}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding ExpiresSoon}" Value="True">
                    <Setter Property="TextColor" Value="#C62828" />
                    <Setter Property="FontAttributes" Value="Bold" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Grid>
</Border>
